{
  "name": "maomao-design-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "猫猫设计工具（React + TypeScript）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "deploy": "npm run build && node tools/deploy.mjs",
    "probe:ps": "node tools/probe-ps.mjs",
    "check:templates": "node tools/check-templates.mjs",
    "check:nav": "node tools/check-nav.mjs",
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm run check:templates && npm run check:nav && npm run test && node scripts/post-check.mjs",
    "new:feature": "node tools/new-feature.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "stylelint": "^16.11.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
